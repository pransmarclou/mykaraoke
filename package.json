{
  "name": "mykaraoke",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "node --env-file=.env.local --import tsx scripts/run-database-tests.ts integration",
    "test:e2e": "node --env-file=.env.local --import tsx scripts/run-database-tests.ts e2e",
    "test:production:smoke": "playwright test --config=playwright.production.config.ts",
    "cleanup:rooms": "node --env-file=.env.local --import tsx scripts/cleanup-rooms.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
