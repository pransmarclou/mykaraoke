# Server-only connections to the MyKaraoke hosted Supabase PostgreSQL database.
# Use Supabase's shared transaction-pooler URL as POSTGRES_URL in serverless
# production. DATABASE_URL remains the fallback for local/persistent runtimes.
# Keep both out of client code; never use a NEXT_PUBLIC_* prefix.
POSTGRES_URL=
DATABASE_URL=

# The canonical origin for invite links and same-origin mutation checks.
# Use HTTPS for a deployed app.
APP_ORIGIN=http://127.0.0.1:3100

# Optional override used only by the non-mutating production shell smoke suite.
# MYKARAOKE_PRODUCTION_ORIGIN=https://mykaraoke.example

# Browser-safe hosted Supabase URL and anon key, returned only to authorized
# room members with an unguessable private Realtime topic. Never put the
# database password or service-role key in browser code.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required only for database-mutating integration and Playwright suites. Set
# this to the exact database hostname of a separate hosted test project. Never
# point it at the live MVP data project.
# MYKARAOKE_TEST_DB_HOST=db.your-mykaraoke-test-project.example

# Server-only official YouTube Data API v3 key. Create a key restricted to the
# YouTube Data API and configure server-side referrer/IP restrictions as suited
# to the deployed backend. Search stays visibly unavailable without this key.
# YOUTUBE_API_KEY=

# Required before deploying beyond localhost. Set ROOM_CLIENT_IP_HEADER only to
# a header overwritten by your trusted reverse proxy; never trust a client-
# supplied header. Use a random secret of at least 32 characters.
# Vercel overwrites x-vercel-forwarded-for with the public client IP.
# ROOM_CLIENT_IP_HEADER=x-vercel-forwarded-for
# ROOM_RATE_LIMIT_SECRET=replace-with-a-long-random-server-secret

# Hosted cleanup requires this explicit exact database hostname.
# MYKARAOKE_CLEANUP_DB_HOST=db.your-mykaraoke-project.example

# Vercel sends this server-only bearer secret to scheduled routes. Use a random
# value of at least 32 characters. Never expose it through NEXT_PUBLIC_*.
# CRON_SECRET=replace-with-a-long-random-server-secret
